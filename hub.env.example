# ============================================================
# hub.env —— 板端一次配置，run.sh 自动加载
# ------------------------------------------------------------
# 用法（板子上做一次）：
#   cp hub.env.example hub.env
#   nano hub.env          # 填入巴法云 UID 等
#   bash scripts/run.sh   # 之后只需这一条
#
# 也可：bash scripts/install_board_env.sh
# ============================================================

# 巴法云 MQTT 私钥 UID（必填才能连云）
export HUB_MQTT_UID=

# 桌面调试：串口登录时也指向本机 X 桌面
export DISPLAY=:0

# 摄像头（有 /dev/video-camera0 时可省略）
# export HUB_CAMERA_DEVICE=/dev/video-camera0

# 值守
# export HUB_PRESENCE=1
# export HUB_PRESENCE_IDLE_SEC=30

# NPU 模型（有 models/yolov8n.rknn 时可省略）
# export HUB_RKNN_MODEL=/home/kickpi/rk3566_hub/models/yolov8n.rknn

# 全屏 framebuffer（需先关桌面）：取消下一行注释，并注释掉上面的 DISPLAY
# unset DISPLAY
# export HUB_QT_PLATFORM=linuxfb
# export HUB_FORCE_LINUXFB=1
